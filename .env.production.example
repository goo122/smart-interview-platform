# Copy to .env.production and replace every placeholder before deployment.
DOMAIN=staging.example.com
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-url-safe-database-password

APP_AI_PROVIDER=openai_compatible
APP_LLM_API_KEY=replace-with-provider-key
APP_LLM_BASE_URL=https://llm.example.com/v1
APP_LLM_MODEL=replace-with-chat-model
APP_INTERVIEW_QUESTION_MODEL=

APP_EMBEDDING_PROVIDER=openai_compatible
APP_EMBEDDING_API_KEY=replace-with-embedding-key
APP_EMBEDDING_BASE_URL=https://embedding.example.com/v1
APP_EMBEDDING_MODEL=replace-with-embedding-model
APP_EMBEDDING_DIMENSIONS=1536
APP_EMBEDDING_BATCH_SIZE=10

# Optional providers can remain unavailable for the first staging deployment.
APP_DEMEANOR_ANALYSIS_PROVIDER=unavailable
APP_SPEECH_TO_TEXT_PROVIDER=unavailable
APP_TEXT_TO_SPEECH_PROVIDER=unavailable
