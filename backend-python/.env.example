# These values are safe local-development placeholders. Never commit a real .env file.
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=replace-me-with-a-long-random-value
APP_JWT_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_REFRESH_TOKEN_EXPIRE_DAYS=7
APP_DATABASE_URL=postgresql+asyncpg://postgres:local-development-only@localhost:5432/ai_interview
APP_REDIS_URL=redis://localhost:6379/0

# Runtime provider selection. Fake is only allowed in development/test.
APP_AI_PROVIDER=unavailable
APP_EMBEDDING_PROVIDER=unavailable
APP_AI_FAKE_MODE=normal
APP_AI_REQUEST_TIMEOUT_SECONDS=60
APP_AI_MAX_RETRIES=2

# Speech-to-text runtime. Fake is only allowed in development/test.
APP_SPEECH_TO_TEXT_PROVIDER=unavailable
APP_XUNFEI_ASR_APP_ID=
APP_XUNFEI_ASR_API_KEY=
APP_XUNFEI_ASR_API_SECRET=
APP_XUNFEI_ASR_URL=wss://iat-api.xfyun.cn/v2/iat
APP_ASR_AUDIO_FORMAT=pcm_s16le
APP_ASR_SAMPLE_RATE=16000
APP_ASR_CHANNELS=1
APP_ASR_MAX_SESSION_SECONDS=120
APP_ASR_MAX_FRAME_BYTES=65536
APP_ASR_MAX_AUDIO_BYTES=5242880

# Text-to-speech runtime. Fake is only allowed in development/test.
APP_TEXT_TO_SPEECH_PROVIDER=unavailable
APP_XUNFEI_TTS_APP_ID=
APP_XUNFEI_TTS_API_KEY=
APP_XUNFEI_TTS_API_SECRET=
APP_XUNFEI_TTS_URL=https://api-dx.xf-yun.com/v1/private/dts_create
APP_TTS_AUDIO_FORMAT=wav
APP_TTS_SAMPLE_RATE=16000
APP_TTS_VOICE=x4_mingge
APP_TTS_MAX_TEXT_LENGTH=10000
APP_TTS_REQUEST_TIMEOUT_SECONDS=90
APP_TTS_TASK_TTL_SECONDS=300
APP_TTS_MAX_REQUESTS_PER_MINUTE=30
APP_TTS_MAX_AUDIO_BYTES=5242880

# Optional model settings. Leave unset to run with the safe unavailable model.
APP_LLM_API_KEY=
APP_LLM_BASE_URL=
APP_LLM_MODEL=
APP_EMBEDDING_API_KEY=
APP_EMBEDDING_BASE_URL=
APP_EMBEDDING_MODEL=
APP_RAG_CHUNK_SIZE=800
APP_RAG_CHUNK_OVERLAP=120
APP_RAG_MAX_CHUNKS_PER_DOCUMENT=1000
APP_RAG_TOP_K=5
APP_RAG_MAX_TOP_K=20
APP_RAG_SIMILARITY_THRESHOLD=0.7
APP_RAG_MAX_CONTEXT_TOKENS=4000
APP_RAG_MAX_CHUNK_TOKENS=1000
APP_RAG_NO_RESULT_POLICY=answer_without_context
# DashScope text-embedding-v4 accepts at most 10 texts per request.
APP_EMBEDDING_BATCH_SIZE=10
APP_EMBEDDING_DIMENSIONS=1536
APP_KNOWLEDGE_MAX_FILE_SIZE=20971520
APP_KNOWLEDGE_STORAGE_DIR=./storage
APP_KNOWLEDGE_TASK_MAX_ATTEMPTS=3
APP_KNOWLEDGE_TASK_RETRY_BASE_SECONDS=2
APP_KNOWLEDGE_TASK_TIMEOUT_SECONDS=300
APP_KNOWLEDGE_PROCESSING_STALE_SECONDS=900
APP_INTERVIEW_PREPARATION_TASK_MAX_ATTEMPTS=3
APP_INTERVIEW_PREPARATION_RETRY_BASE_SECONDS=2
APP_INTERVIEW_PREPARATION_TASK_TIMEOUT_SECONDS=300
APP_INTERVIEW_PREPARATION_STALE_SECONDS=900
APP_INTERVIEW_PREPARATION_RECOVERY_INTERVAL_SECONDS=60
APP_INTERVIEW_PREPARATION_RECOVERY_BATCH_SIZE=100
APP_INTERVIEW_ANSWER_TASK_MAX_ATTEMPTS=3
APP_INTERVIEW_ANSWER_RETRY_BASE_SECONDS=2
APP_INTERVIEW_ANSWER_TASK_TIMEOUT_SECONDS=300
APP_INTERVIEW_ANSWER_STALE_SECONDS=900
APP_INTERVIEW_ANSWER_RECOVERY_INTERVAL_SECONDS=60
APP_INTERVIEW_ANSWER_RECOVERY_BATCH_SIZE=100

# Interview answer evaluation and dynamic follow-up policy.
APP_INTERVIEW_MAX_FOLLOW_UP_DEPTH=2
APP_INTERVIEW_FOLLOW_UP_SCORE_THRESHOLD=70
APP_INTERVIEW_MAX_FOLLOW_UPS_PER_SESSION=5
APP_INTERVIEW_MIN_ANSWER_LENGTH=10
APP_INTERVIEW_MAX_ANSWER_LENGTH=10000

# Deterministic final-report aggregation.
APP_REPORT_PRIMARY_TURN_WEIGHT=1.0
APP_REPORT_FOLLOW_UP_TURN_WEIGHT=0.5
APP_REPORT_TECHNICAL_WEIGHT=0.35
APP_REPORT_RELEVANCE_WEIGHT=0.20
APP_REPORT_CLARITY_WEIGHT=0.20
APP_REPORT_DEPTH_WEIGHT=0.25
APP_REPORT_AGGREGATION_VERSION=v1

# Used by the root docker-compose.yml for the local PostgreSQL container only.
POSTGRES_PASSWORD=local-development-only
